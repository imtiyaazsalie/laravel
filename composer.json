{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "ext-calendar": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "ext-soap": "*",
        "adoy/oauth2": "^1.3",
        "andreaselia/laravel-api-to-postman": "^1.15",
        "awobaz/compoships": "^2.2",
        "barryvdh/laravel-dompdf": "^2.0",
        "ctwillie/expo-server-sdk-php": "^2.0",
        "digitick/sepa-xml": "^2.2",
        "doctrine/dbal": "^3.6",
        "genkgo/camt": "^2.6",
        "gocardless/gocardless-pro": "^4.24",
        "guzzlehttp/guzzle": "^7.2",
        "haydenpierce/class-finder": "^0.5.3",
        "hidehalo/nanoid-php": "^1.1",
        "kirschbaum-development/eloquent-power-joins": "^3.0",
        "laravel/framework": "^10.0",
        "laravel/horizon": "^5.24",
        "laravel/pail": "^1.1",
        "laravel/passport": "^11.1",
        "laravel/pulse": "^1.0@beta",
        "laravel/sanctum": "^3.2",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^2.7",
        "lcobucci/jwt": "^5.2",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "league/iso3166": "^4.3",
        "maatwebsite/excel": "^3.1",
        "payfast/payfast-php-sdk": "^1.1.6",
        "predis/predis": "^2.1.1",
        "psr/simple-cache": "^2.0",
        "reedware/laravel-composite-relations": "^3.0",
        "spatie/laravel-csp": "^2.9",
        "spatie/laravel-ignition": "^2.4",
        "spatie/laravel-query-builder": "^5.0",
        "spatie/laravel-validation-rules": "^3.3",
        "stripe/stripe-php": "^15.7",
        "therobfonz/laravel-mandrill-driver": "^5.1",
        "treblle/security-headers": "^0.0.3"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.12",
        "fakerphp/faker": "^1.9.1",
        "kitloong/laravel-migrations-generator": "^6.10",
        "knuckleswtf/scribe": "^4.22",
        "larastan/larastan": "^2.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "pestphp/pest": "^2.5",
        "pestphp/pest-plugin-faker": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "phpunit/phpunit": "^10.0",
        "spatie/pest-plugin-test-time": "^2.0",
        "timacdonald/log-fake": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan horizon:publish --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "lint": [
            "./vendor/bin/pint"
        ],
        "lint-dirty": [
            "./vendor/bin/pint --dirty"
        ],
        "sniff": [
            "./vendor/bin/pint --test"
        ],
        "stan": [
            "./vendor/bin/phpstan analyse --memory-limit=512M"
        ],
        "test": [
            "./vendor/bin/pest --coverage --coverage-html=coverage/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}